DATABASE_URL="postgresql://market:market@localhost:5432/2ie_market?schema=public"
JWT_SECRET="remplacez-par-une-chaine-aleatoire-d-au-moins-32-caracteres"
FRONTEND_URL="http://localhost:5173"
API_PORT="3000"
# En production, la plateforme définit généralement PORT automatiquement.
NODE_ENV="development"
ADMIN_EMAIL="admin@2ie-market.local"
ADMIN_PASSWORD="Admin1234!"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="2ie Market"
REVIEWS_ENABLED="false"

# Stockage permanent des photos (profil, boutique, logo de la plateforme et annonces).
# En production, créez un bucket Supabase public nommé 2ie-market-media.
SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cle-service-role-a-conserver-cote-serveur"
SUPABASE_STORAGE_BUCKET="2ie-market-media"

# Private bucket used only for seller payment proofs (must not be public).
SUPABASE_PRIVATE_BUCKET=2ie-market-private
